{
  "name": "specweaver",
  "version": "0.1.0",
  "description": "Turn OpenAPI definitions plus a YAML config into k6 load tests.",
  "type": "module",
  "bin": {
    "specweaver": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "test": "npm run build && node --test"
  },
  "keywords": [
    "k6",
    "openapi",
    "load-testing",
    "faker"
  ],
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  },
  "dependencies": {
    "yaml": "^2.9.1"
  }
}
