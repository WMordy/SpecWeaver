{
  "name": "@wmordy/specweaver",
  "version": "1.0.0",
  "description": "Turn OpenAPI definitions plus a YAML config into k6 load tests.",
  "type": "module",
  "bin": {
    "specweaver": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || ^23.5.0 || >=24.0.0",
    "npm": ">=10"
  },
  "scripts": {
    "build": "tsc",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "test": "npm run build && node --test",
    "test:live-e2e": "npm run build && node --test e2e/live-e2e.mjs"
  },
  "keywords": [
    "k6",
    "openapi",
    "load-testing",
    "faker"
  ],
  "homepage": "https://github.com/WMordy/SpecWeaver#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/WMordy/SpecWeaver.git"
  },
  "bugs": {
    "url": "https://github.com/WMordy/SpecWeaver/issues"
  },
  "author": "WMORDY <wmordy99@gmail.com>",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  },
  "dependencies": {
    "@faker-js/faker": "^10.6.0",
    "yaml": "^2.9.1"
  }
}
